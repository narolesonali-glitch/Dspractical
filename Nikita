#include <iostream>
#include <iomanip>
using namespace std;

int main()
{
    int n;
    float a[100], b[100], c[100];

    cout << "Enter number of students: ";
    cin >> n;

    cout << "Enter first year percentages: ";
    for(int i = 0; i < n; i++)
    {
        cin >> a[i];
        b[i] = a[i];
        c[i] = a[i];
    }

    // Selection Sort
    for(int i = 0; i < n-1; i++)
    {
        int min = i;

        for(int j = i+1; j < n; j++)
        {
            if(b[j] < b[min])
                min = j;
        }

        float temp = b[i];
        b[i] = b[min];
        b[min] = temp;
    }

    cout << fixed << setprecision(2);

    cout << "\nSorted using Selection sort: ";
    for(int i = 0; i < n; i++)
        cout << b[i] << " ";

    cout << "\nTop Five Scores: ";
    for(int i = 0; i < 5 && i < n; i++)
        cout << b[i] << " ";

    // Bubble Sort
    for(int i = 0; i < n-1; i++)
    {
        for(int j = 0; j < n-i-1; j++)
        {
            if(c[j] > c[j+1])
            {
                float temp = c[j];
                c[j] = c[j+1];
                c[j+1] = temp;
            }
        }
    }

    cout << "\n\nSorted using Bubble Sort: ";
    for(int i = 0; i < n; i++)
        cout << c[i] << " ";

    cout << "\nTop Five Scores: ";
    for(int i = 0; i < 5 && i < n; i++)
        cout << c[i] << " ";

    return 0;
}